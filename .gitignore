# Ignore node_modules (dependencies)
node_modules/
backend/node_modules/
frontend/node_modules/

# Ignore environment variables
.env
backend/.env
frontend/.env

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore logs & cache
*.log
npm-debug.log
yarn-debug.log
yarn-error.log
backend/logs/
frontend/logs/

# Ignore build artifacts
dist/
build/
backend/build/
frontend/build/
backend/coverage/
frontend/coverage/

# Ignore IDE settings
.vscode/
.idea/
*.swp

# Ignore generated lockfiles
backend/package-lock.json
frontend/package-lock.json